{
  "protocol_id": "r2_pdf_locked_v1",
  "source": "ESWA manuscript revision protocol",
  "graph": {
    "stored_edge_semantics": "undirected_simple_edge_stored_once",
    "message_passing_graph": "bidirected_projection",
    "diffusion_graph": "each_undirected_edge_as_two_opposite_directed_edges"
  },
  "diffusion": {
    "model": "independent_cascade_weighted_cascade",
    "edge_probability": "1 / in_degree(target)_in_bidirected_diffusion_graph",
    "collection_mc_trials": 100,
    "evaluation_mc_trials": 1000,
    "activated_seed_nodes_included": true
  },
  "node_features": {
    "ordered_features": [
      "in_degree",
      "out_degree",
      "pagerank",
      "seed_availability_indicator"
    ],
    "feature_dim": 4
  },
  "model": {
    "shared_trajectory_encoder": {
      "type": "gat",
      "depth": 3,
      "heads_per_layer": 4,
      "output_dim_per_head": 64
    },
    "actor": {
      "type": "gcn",
      "depth": 2,
      "hidden_dim": 128,
      "output_activation": "sigmoid"
    },
    "critics": {
      "count": 2,
      "type": "gcn",
      "depth": 2,
      "hidden_dim": 128,
      "output": "scalar_complete_one_shot_action_value"
    }
  },
  "training": {
    "training_seeds": [11, 22, 33, 44, 55],
    "max_epochs": 2000,
    "batch_size": 5,
    "actor_lr": 5e-7,
    "critic_lr": 5e-4,
    "temperature_lr": 5e-5,
    "discount": 0.9,
    "beta": 4,
    "target_update_tau": 0.005
  },
  "budget": {
    "ratios_percent": [1, 3, 5, 10, 20],
    "rule": "max(1, floor(ratio * num_full_graph_nodes / 100))"
  }
}
